# Runtime data — never commit
# (includes data/.c2pa/{cert,key}.pem generated by scripts/c2pa-gen-dev-cert.sh —
#  the private key must never end up in the repo)
data/
backups/

# User workspace — runtime content, not source (root only)
/workspace/

# Actual env file — only .env.example is tracked
.env
.codex-*-auth/

# Claude Code project state
.claude/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and databases
*.log
*.db
*.db-shm
*.db-wal

# OS
.DS_Store
Thumbs.db
