# Botji single-tenant deployment
# Copy to .env and edit.
# Generate secrets:
#   openssl rand -hex 32

BOTJI_TENANT_ID=botji
BOTJI_DATA_DIR=./data/botji
BOTJI_WORKSPACE_DIR=./workspace
BOTJI_IMAGE_NAME=botji/hermes-codex
BOTJI_IMAGE_TAG=local

# Pull latest moving Hermes build by default.
# For production, pin to a digest or sha-* tag after your smoke test.
HERMES_IMAGE=nousresearch/hermes-agent:main
CODEX_NPM_VERSION=latest

# Use host UID/GID so files in ./data stay editable by you.
# The Makefile exports these automatically; set manually if not using make.
HERMES_UID=10000
HERMES_GID=10000

TZ=Europe/Amsterdam

# Telegram.
# LOCAL DEV: create a separate test bot via @BotFather — never reuse the production bot here.
# PRODUCTION: bot token is injected from the VPS_ENV CI secret; do NOT set it here.
# This separation prevents local test commands from appearing in the live production chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=Botji Home
GATEWAY_ALLOW_ALL_USERS=false

# Local-only dashboard/API ports.
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD=1
HERMES_DASHBOARD_TUI=1
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-me-with-openssl-rand-hex-32
API_SERVER_CORS_ORIGINS=http://127.0.0.1:9119

# Codex authentication.
# Run `make codex-login` to use ChatGPT/Codex subscription auth.
# Credentials persist under ./data/botji/.codex.

# Botji discipline.
BOTJI_DEFAULT_TRUTH_MODE=fidelity
BOTJI_RENDER_LEASE_DB=
BOTJI_VERDICTS_DIR=
BOTJI_FORCE_SEED=0

# Resource limits.
BOTJI_MEMORY_LIMIT=4G
BOTJI_CPU_LIMIT=2.0

# Debug toggles.
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# Observability: Hermes ships built-in tooling — no external service needed.
#   docker exec botji-hermes hermes insights          # tokens, costs, tools, models
#   docker exec botji-hermes hermes sessions stats    # session store stats
#   docker exec botji-hermes hermes logs errors -n 50 # filtered errors view
#   ssh -L 9119:127.0.0.1:9119 ... → http://127.0.0.1:9119  # web dashboard
#
# To re-enable Langfuse tracing in the future: uncomment + populate, and add
# `observability/langfuse` back to seed/hermes/config.yaml plugins.enabled.
# HERMES_LANGFUSE_PUBLIC_KEY=
# HERMES_LANGFUSE_SECRET_KEY=
# HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# HERMES_LANGFUSE_ENV=production
