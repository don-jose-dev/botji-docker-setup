  <rect x="40" y="50" width="220" height="120" fill="#e9f0ff" stroke="#2250aa"/>
  <circle cx="420" cy="140" r="70" fill="#ffe1e1" stroke="#aa2533"/>
  <text x="80" y="250">BOTJI SVG HARNESS</text>
</svg>
""",
        encoding="utf-8",
    )
    return path


