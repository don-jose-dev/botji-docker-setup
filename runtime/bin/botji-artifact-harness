FILE_NAME('botji-harness.step','2026-05-15T00:00:00',('Botji'),('Botji'),'','','');
FILE_SCHEMA(('AP214'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('',(100.,0.,0.));
#3=DIRECTION('',(0.,0.,1.));
ENDSEC;
END-ISO-10303-21;
""",
        encoding="utf-8",
    )
    return path


def make_ifc_fixture(path: Path) -> Path:
    path.write_text(
        """ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Botji harness IFC'),'2;1');
FILE_NAME('botji-harness.ifc','2026-05-15T00:00:00',('Botji'),('Botji'),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0J$botji',$,'Harness Project',$,$,$,$,$);
