#!/opt/hermes/.venv/bin/python
"""Run Botji generic artifact adapter compliance checks.

This harness exercises the generic, non-provider spine:
register -> extract -> normalize -> render_schema -> review.

It uses deterministic local fixtures only. Image provider and vision review
coverage belongs in botji-artifact-e2e.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import subprocess
import sys
import struct
import wave
import zipfile
from pathlib import Path
from typing import Any


ADAPTERS = (
    "text",
    "image",
    "pdf",
    "dxf",
    "docx",
    "xlsx",
    "html",
    "svg",
    "step",
    "ifc",
    "zip",
    "audio",
    "video",
    "binary",
)
MODALITY_COMPARATORS = {
    "image": "image_schema_metadata_compare",
    "text": "text_line_span_compare",
    "pdf": "pdf_page_text_compare",
    "dxf": "dxf_entity_geometry_compare",
    "docx": "docx_openxml_compare",
    "xlsx": "xlsx_openxml_compare",
    "html": "html_dom_text_compare",
    "svg": "svg_vector_xml_compare",
    "step": "step_entity_compare",
    "ifc": "ifc_entity_hierarchy_compare",
    "zip": "zip_manifest_crc_compare",
    "audio": "audio_header_compare",
    "video": "video_container_compare",
    "binary": "binary_checksum_signature_compare",
}


def drop_root_to_runtime_user() -> None:
    """Docker exec defaults to root; Botji artifacts must be owned by Hermes."""
    if os.name != "posix" or not hasattr(os, "geteuid") or os.geteuid() != 0:
        return

    uid = int(os.environ.get("HERMES_UID", "10000"))
    gid = int(os.environ.get("HERMES_GID", str(uid)))
    home = Path(os.environ.get("HERMES_HOME", "/opt/data"))
    artifact_root = Path(os.environ.get("BOTJI_ARTIFACT_ROOT", str(home / "artifacts")))
    runtime_dirs = [
        home,
        artifact_root,
        artifact_root / "harness",
        artifact_root / "harness" / "fixtures",
        artifact_root / "sources",
        artifact_root / "outputs",
        artifact_root / "evidence",
        artifact_root / "reviews",
        artifact_root / "index",
        home / "reviews",
    ]
    for path in runtime_dirs:
        path.mkdir(parents=True, exist_ok=True)
        os.chown(path, uid, gid)
    for child in (artifact_root / "harness" / "fixtures").iterdir():
        os.chown(child, uid, gid)

    os.environ["HOME"] = str(home)
    os.setgid(gid)
    os.setuid(uid)


def load_plugin():
    home = Path(os.environ.get("HERMES_HOME", "/opt/data"))
    plugin_path = home / "plugins" / "botji-artifacts" / "__init__.py"
    if not plugin_path.is_file():
        raise SystemExit(f"botji-artifacts plugin not found: {plugin_path}")
    spec = importlib.util.spec_from_file_location("botji_artifacts_plugin", plugin_path)
    if spec is None or spec.loader is None:
        raise SystemExit(f"cannot import plugin: {plugin_path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def call_tool(module: Any, name: str, args: dict[str, Any]) -> dict[str, Any]:
    handler = getattr(module, f"_handle_{name}")
    payload = json.loads(handler(args))
    if not payload.get("success"):
        raise RuntimeError(f"{name} failed: {payload.get('error')} ({payload.get('error_type')})")
    return payload


def validate_schema_payload(payload: dict[str, Any]) -> None:
    schema_path = Path(os.environ.get("BOTJI_ARTIFACT_SCHEMA", "/opt/data/schemas/artifact_schema.schema.json"))
    if not schema_path.is_file():
        return
    from jsonschema import Draft202012Validator

    schema = json.loads(schema_path.read_text(encoding="utf-8"))
    errors = sorted(Draft202012Validator(schema).iter_errors(payload), key=lambda error: list(error.path))
    if errors:
        first = errors[0]
        path = ".".join(str(part) for part in first.path) or "<root>"
        raise RuntimeError(f"artifact schema validation failed at {path}: {first.message}")


def fixture_dir() -> Path:
    root = Path(os.environ.get("BOTJI_ARTIFACT_ROOT", "/opt/data/artifacts"))
    path = root / "harness" / "fixtures"
    path.mkdir(parents=True, exist_ok=True)
    return path


def make_text_fixture(path: Path) -> Path:
    path.write_text(
        "\n".join(
            [
                "Botji artifact harness text fixture.",
                "Line 2 preserves a concrete span.",
                "Line 3 is used for schema normalization.",
            ]
        )
        + "\n",
        encoding="utf-8",
    )
    return path


def make_image_fixture(path: Path) -> Path:
    from PIL import Image, ImageDraw

    image = Image.new("RGB", (640, 420), "white")
    draw = ImageDraw.Draw(image)
    draw.rectangle((70, 75, 360, 300), outline=(30, 80, 170), width=8, fill=(225, 235, 255))
    draw.ellipse((390, 120, 550, 280), outline=(180, 35, 45), width=8, fill=(255, 225, 225))
    draw.text((90, 320), "BOTJI HARNESS", fill=(30, 30, 30))
    image.save(path)
    return path


def make_pdf_fixture(path: Path) -> Path:
    try:
        import pymupdf
    except Exception:
        import fitz as pymupdf

    doc = pymupdf.open()
    page = doc.new_page(width=595, height=842)
    page.insert_text((72, 72), "Botji artifact harness PDF fixture")
    page.insert_text((72, 110), "This page has deterministic text and page geometry.")
    doc.save(str(path))
    doc.close()
    return path


def make_dxf_fixture(path: Path) -> Path:
    import ezdxf

    doc = ezdxf.new("R2010")
    doc.header["$INSUNITS"] = 4
    msp = doc.modelspace()
    msp.add_line((0, 0), (1000, 0))
    msp.add_line((1000, 0), (1000, 500))
    msp.add_line((1000, 500), (0, 500))
    msp.add_line((0, 500), (0, 0))
    msp.add_text("BOTJI HARNESS").set_placement((100, 250))
    doc.saveas(path)
    return path


def make_docx_fixture(path: Path) -> Path:
    document = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:body>
    <w:p><w:r><w:t>Botji artifact harness DOCX fixture.</w:t></w:r></w:p>
    <w:p><w:r><w:t>Paragraph two preserves OpenXML text evidence.</w:t></w:r></w:p>
    <w:tbl><w:tr><w:tc><w:p><w:r><w:t>Cell A1</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
  </w:body>
</w:document>
"""
    content_types = """<?xml version="1.0" encoding="UTF-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension="xml" ContentType="application/xml"/>
  <Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>
</Types>
"""
    with zipfile.ZipFile(path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("[Content_Types].xml", content_types)
        archive.writestr("word/document.xml", document)
    return path


def make_xlsx_fixture(path: Path) -> Path:
    workbook = """<?xml version="1.0" encoding="UTF-8"?>
<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
  <sheets><sheet name="Harness" sheetId="1" r:id="rId1" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"/></sheets>
</workbook>
"""
    sheet = """<?xml version="1.0" encoding="UTF-8"?>
<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
  <dimension ref="A1:B2"/>
  <sheetData>
    <row r="1"><c r="A1" t="inlineStr"><is><t>Botji</t></is></c><c r="B1"><v>42</v></c></row>
    <row r="2"><c r="A2" t="inlineStr"><is><t>Harness</t></is></c><c r="B2"><f>B1*2</f><v>84</v></c></row>
  </sheetData>
</worksheet>
"""
    shared = """<?xml version="1.0" encoding="UTF-8"?>
<sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" count="2" uniqueCount="2">
  <si><t>Botji</t></si><si><t>Harness</t></si>
</sst>
"""
    content_types = """<?xml version="1.0" encoding="UTF-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension="xml" ContentType="application/xml"/>
  <Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>
  <Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>
  <Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/>
</Types>
"""
    with zipfile.ZipFile(path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("[Content_Types].xml", content_types)
        archive.writestr("xl/workbook.xml", workbook)
        archive.writestr("xl/worksheets/sheet1.xml", sheet)
        archive.writestr("xl/sharedStrings.xml", shared)
    return path


