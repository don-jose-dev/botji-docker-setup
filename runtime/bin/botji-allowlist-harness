#!/opt/hermes/.venv/bin/python
"""Deterministic harness for botji-allowlist behavior."""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
import tempfile
import time
from pathlib import Path
from types import SimpleNamespace
from typing import Any


def load_plugin(path: Path):
    spec = importlib.util.spec_from_file_location("botji_allowlist_harness_plugin", path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import allowlist plugin: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def event(user_id: str) -> Any:
    return SimpleNamespace(platform="telegram", sender_id=user_id, sender_name=f"user-{user_id}")


def assert_allowed(module: Any, user_id: str) -> None:
    result = module._pre_gateway_dispatch(event(user_id))
    if result is not None:
        raise AssertionError(f"user {user_id} should be allowed, got {result}")


def assert_rejected(module: Any, user_id: str) -> None:
    result = module._pre_gateway_dispatch(event(user_id))
    if not isinstance(result, dict) or result.get("action") != "skip":
        raise AssertionError(f"user {user_id} should be rejected, got {result}")


def write_json(path: Path, payload: dict[str, Any]) -> None:
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    # Make mtime changes visible on coarse filesystems.
    time.sleep(0.02)
    os.utime(path, None)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--plugin-path",
        default=str(Path(os.environ.get("HERMES_HOME", "/opt/data")) / "plugins" / "botji-allowlist" / "__init__.py"),
    )
    args = parser.parse_args()

    plugin_path = Path(args.plugin_path)
    if not plugin_path.is_file():
        raise SystemExit(f"botji-allowlist plugin not found: {plugin_path}")

    with tempfile.TemporaryDirectory(prefix="botji-allowlist-") as tmp:
        allowlist_path = Path(tmp) / "allowed_users.json"
        os.environ["BOTJI_ALLOWLIST_PATH"] = str(allowlist_path)
        os.environ["TELEGRAM_ALLOWED_USERS"] = "111,333"
        module = load_plugin(plugin_path)

        # Missing file uses env fallback for bootstrap compatibility.
        assert_allowed(module, "111")
        assert_rejected(module, "222")

        # Once a JSON file exists, it overrides env and hot-reloads.
        write_json(allowlist_path, {"users": ["222"]})
        assert_allowed(module, "222")
        assert_rejected(module, "111")

        # Bad JSON keeps the previous good set rather than opening the gate.
        allowlist_path.write_text("{not-json", encoding="utf-8")
        time.sleep(0.02)
        os.utime(allowlist_path, None)
        assert_allowed(module, "222")
        assert_rejected(module, "111")

        # Bootstrap creates the JSON file from env only when it is missing.
        allowlist_path.unlink()
        module._cache = None
        module._bootstrap_file_from_env_if_missing()
        data = json.loads(allowlist_path.read_text(encoding="utf-8"))
        if sorted(data.get("users", [])) != ["111", "333"]:
            raise AssertionError(f"bootstrap users mismatch: {data}")

    print(json.dumps({"success": True, "checks": ["env_fallback", "file_override_hot_reload", "bad_json_keeps_previous", "bootstrap_from_env"]}, indent=2))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(json.dumps({"success": False, "error": str(exc), "error_type": type(exc).__name__}, indent=2), file=sys.stderr)
        raise SystemExit(2)
