#!/opt/hermes/.venv/bin/python
"""Unified test runner for Botji deterministic harnesses.

Replaces five separate scripts:
  - botji-core-harness           -> run --suite core
  - botji-gate-harness           -> run --suite gate
  - botji-allowlist-harness      -> run --suite allowlist
  - botji-contract-new           -> run --suite contract
  - botji-fidelity-guard-harness -> run --suite fidelity-guard

Plus three newer suites:
  - run --suite id-family        -> rejects mixed art_*/src_*/out_* IDs
  - run --suite cron             -> validates cron/*.yaml seeds are well-formed
  - run --suite render           -> validates kanban/workflows/*.yaml templates
                                    and skill cross-references stay in sync

Fixtures live in tests/fixtures/<suite>/*.yaml. Each fixture has:
  id:          stable identifier (filename stem if omitted)
  description: human-readable summary
  inputs:      suite-specific test setup
  expected:    suite-specific assertion data

One pure function per suite. Handlers are responsible for tempdir
setup, plugin load, predicate evaluation. No classes for orchestration.
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
import tempfile
import time
import uuid
from pathlib import Path
from types import SimpleNamespace
from typing import Any, Callable

import yaml  # type: ignore[import-not-found]


# ---------------------------------------------------------------------------
# Plugin loading
# ---------------------------------------------------------------------------

def _plugin_path(plugin_name: str) -> Path:
    """Locate plugin __init__.py. Prefer VPS layout, fall back to repo seed."""
    home = Path(os.environ.get("HERMES_HOME", "/opt/data"))
    candidate = home / "plugins" / plugin_name / "__init__.py"
    if candidate.is_file():
        return candidate
    return Path(__file__).resolve().parents[2] / "seed" / "hermes" / "plugins" / plugin_name / "__init__.py"


def _load_module(plugin_path: Path, module_name: str) -> Any:
    spec = importlib.util.spec_from_file_location(module_name, plugin_path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {plugin_path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    spec.loader.exec_module(module)
    return module


class _FakeContext:
    def __init__(self) -> None:
        self.tools: dict[str, Any] = {}
        self.hooks: dict[str, list[Any]] = {}

    def register_tool(self, *, name: str, handler: Any, **_: Any) -> None:
        self.tools[name] = handler

    def register_hook(self, hook_name: str, callback: Any) -> None:
        self.hooks.setdefault(hook_name, []).append(callback)


def _call_tool(ctx: _FakeContext, name: str, payload: dict) -> dict:
    return json.loads(ctx.tools[name](payload))


def _invoke_pre_tool_call(ctx: _FakeContext, tool_name: str, args: dict, session_id: str = "") -> dict | None:
    """Replay the Hermes pre_tool_call dispatch: first block wins."""
    for cb in ctx.hooks.get("pre_tool_call", []):
        try:
            result = cb(tool_name=tool_name, args=args, session_id=session_id)
        except Exception:
            continue
        if isinstance(result, dict) and result.get("action") == "block":
            return result
    return None


def _resolve(value: Any, bindings: dict) -> Any:
    """Resolve $-prefixed bindings in fixture args (recursively)."""
    if isinstance(value, str) and value.startswith("$"):
        ref = value[1:]
        if ref not in bindings:
            raise KeyError(f"unbound reference: ${ref}")
        return bindings[ref]
    if isinstance(value, list):
        return [_resolve(v, bindings) for v in value]
    if isinstance(value, dict):
        return {k: _resolve(v, bindings) for k, v in value.items()}
    return value


# ---------------------------------------------------------------------------
# Suite: core
# ---------------------------------------------------------------------------

def run_core(fixture: dict) -> tuple[bool, str]:
    """Sequence of botji-core tool calls + assertions on the last result.

    inputs.files: {label: content} → creates incoming/<label>.txt, binds path:<label>
    inputs.legacy_artifacts: list of legacy registry entries (artifact_id, role, content)
    inputs.steps: list of {tool, args, save_as?} — save_as binds id fields
    expected: dict of result-key comparisons (special: artifact_id_prefix)
    """
    plugin_path = _plugin_path("botji-core")
    with tempfile.TemporaryDirectory(prefix="botji-h-core-") as tmp:
        home = Path(tmp)
        os.environ["HERMES_HOME"] = str(home)
        os.environ["BOTJI_CORE_ROOT"] = str(home / "botji-core")
        os.environ["BOTJI_ARTIFACT_ROOT"] = str(home / "artifacts")
        ctx = _FakeContext()
        module = _load_module(plugin_path, f"botji_core_h_{uuid.uuid4().hex[:8]}")
        module.register(ctx)

        bindings: dict[str, Any] = {}
        inputs = fixture.get("inputs") or {}
        for label, content in (inputs.get("files") or {}).items():
            fp = home / "incoming" / f"{label}.txt"
            fp.parent.mkdir(parents=True, exist_ok=True)
            fp.write_text(content, encoding="utf-8")
            bindings[f"path:{label}"] = str(fp)

        for entry in inputs.get("legacy_artifacts") or []:
            art_id = entry["artifact_id"]
            data_path = home / "artifacts" / "legacy" / art_id / "data.txt"
            data_path.parent.mkdir(parents=True, exist_ok=True)
            data_path.write_text(entry.get("content", "legacy"), encoding="utf-8")
            index = home / "artifacts" / "index" / "artifacts.jsonl"
            index.parent.mkdir(parents=True, exist_ok=True)
            with index.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps({
                    "artifact_id": art_id,
                    "role": entry.get("role", "source"),
                    "path": str(data_path),
                    "parents": entry.get("parents", []),
                    "created_at": "2026-05-20T00:00:00Z",
                }) + "\n")

        last: dict[str, Any] = {}
        for step in inputs.get("steps") or []:
            args = _resolve(step.get("args") or {}, bindings)
            last = _call_tool(ctx, step["tool"], args)
            save_as = step.get("save_as")
            if save_as and isinstance(last, dict):
                for k in ("source_id", "artifact_id", "receipt_id", "output_id"):
                    if last.get(k) is not None:
                        bindings[f"{save_as}.{k}"] = last[k]

        return _check_expected(last, fixture.get("expected") or {})


def _check_expected(result: dict, expected: dict) -> tuple[bool, str]:
    for key, want in expected.items():
        if key == "artifact_id_prefix":
            artifact_id = (
                result.get("artifact_id")
                or (result.get("source") or {}).get("artifact_id")
                or (result.get("artifact") or {}).get("artifact_id")
            )
            if not isinstance(artifact_id, str) or not artifact_id.startswith(want):
                return False, f"artifact_id {artifact_id!r} missing prefix {want!r}"
            continue
        if result.get(key) != want:
            return False, f"expected {key}={want!r}, got {result.get(key)!r}"
    return True, "ok"


def _check_hook_result(
    ctx: _FakeContext, fixture: dict, args: dict,
    tool_name: str = "artifact_review", session_id: str = "session-h",
) -> tuple[bool, str]:
    """Invoke pre_tool_call and assert pre_hook expectations.

    expected.pre_hook: "block" or "allow"
    expected.message_contains: substring required in the block message
    """
    expected = fixture.get("expected") or {}
    result = _invoke_pre_tool_call(ctx, tool_name, args, session_id)
    want = expected.get("pre_hook")
    if want == "allow":
        if result is not None:
            return False, f"expected allow, got block: {result!r}"
        return True, "ok"
    if want == "block":
        if not (isinstance(result, dict) and result.get("action") == "block"):
            return False, f"expected block, got {result!r}"
        needle = expected.get("message_contains")
        if needle and needle not in str(result.get("message") or ""):
            return False, f"message missing {needle!r}: {result.get('message')!r}"
        return True, "ok"
    return False, f"expected.pre_hook must be 'block' or 'allow', got {want!r}"


# ---------------------------------------------------------------------------
# Suite: gate
# ---------------------------------------------------------------------------

def run_gate(fixture: dict) -> tuple[bool, str]:
    """Write verdict files, then call _transform_llm_output and assert.

    inputs.verdicts: [{session_id, payload, age_seconds?}]
    inputs.calls:    [{session_id, llm_output}]
    expected.outputs: [{session_id, passthrough?, contains?, not_contains?}]
    """
    plugin_path = _plugin_path("botji-gate")
    with tempfile.TemporaryDirectory(prefix="botji-h-gate-") as tmp:
        verdict_root = Path(tmp) / "verdicts"
        verdict_root.mkdir(parents=True, exist_ok=True)
        os.environ["BOTJI_VERDICT_ROOT"] = str(verdict_root)
        module = _load_module(plugin_path, f"botji_gate_h_{uuid.uuid4().hex[:8]}")

        inputs = fixture.get("inputs") or {}
        for verdict in inputs.get("verdicts") or []:
            path = verdict_root / f"{verdict['session_id']}.verdict.json"
            path.write_text(json.dumps(verdict["payload"], indent=2), encoding="utf-8")
            age = verdict.get("age_seconds")
            if age is not None:
                stamp = time.time() - float(age)
                os.utime(path, (stamp, stamp))

        results: dict[str, Any] = {}
        for call in inputs.get("calls") or []:
            sid = call["session_id"]
            results[sid] = module._transform_llm_output(call.get("llm_output", ""), session_id=sid)

        for want in (fixture.get("expected") or {}).get("outputs") or []:
            sid = want["session_id"]
            if sid not in results:
                return False, f"no call for session {sid!r}"
            got = results[sid]
            if want.get("passthrough"):
                if got is not None:
                    return False, f"session {sid}: expected passthrough, got {got!r}"
                continue
            for needle in (want.get("contains") or []) if isinstance(want.get("contains"), list) else ([want["contains"]] if want.get("contains") else []):
                if not isinstance(got, str) or needle not in got:
                    return False, f"session {sid}: {needle!r} not in {got!r}"
            for needle in (want.get("not_contains") or []) if isinstance(want.get("not_contains"), list) else ([want["not_contains"]] if want.get("not_contains") else []):
                if isinstance(got, str) and needle in got:
                    return False, f"session {sid}: forbidden {needle!r} found in {got!r}"
        return True, "ok"


# ---------------------------------------------------------------------------
# Suite: allowlist
# ---------------------------------------------------------------------------

def run_allowlist(fixture: dict) -> tuple[bool, str]:
    """Seed allowed_users.json + env, then check who passes pre_gateway_dispatch.

    inputs.initial_file:             dict written as initial JSON
    inputs.invalid_file:             raw string (corrupts the file after init)
    inputs.env_allowed:              TELEGRAM_ALLOWED_USERS value
    inputs.delete_file_then_bootstrap: bool — exercise _bootstrap_file_from_env_if_missing()
    expected.allowed / expected.rejected: user IDs
    expected.bootstrap_users:        list of users expected in the file after bootstrap
    """
    plugin_path = _plugin_path("botji-allowlist")
    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}

    with tempfile.TemporaryDirectory(prefix="botji-h-allow-") as tmp:
        allowlist_path = Path(tmp) / "allowed_users.json"
        os.environ["BOTJI_ALLOWLIST_PATH"] = str(allowlist_path)
        if "env_allowed" in inputs:
            os.environ["TELEGRAM_ALLOWED_USERS"] = str(inputs["env_allowed"])
        else:
            os.environ.pop("TELEGRAM_ALLOWED_USERS", None)

        module = _load_module(plugin_path, f"botji_allow_h_{uuid.uuid4().hex[:8]}")

        if "initial_file" in inputs:
            allowlist_path.write_text(json.dumps(inputs["initial_file"], indent=2) + "\n", encoding="utf-8")
            time.sleep(0.02)
            os.utime(allowlist_path, None)
            # Prime the in-memory cache so subsequent corrupt writes have a
            # "previous good" set to fall back to (matches production behaviour
            # where every dispatch re-reads on mtime change).
            module._pre_gateway_dispatch(SimpleNamespace(
                platform="telegram", sender_id="__warmup__", sender_name="warmup",
            ))
        if "invalid_file" in inputs:
            allowlist_path.write_text(str(inputs["invalid_file"]), encoding="utf-8")
            time.sleep(0.02)
            os.utime(allowlist_path, None)

        if inputs.get("delete_file_then_bootstrap"):
            if allowlist_path.exists():
                allowlist_path.unlink()
            module._cache = None
            module._bootstrap_file_from_env_if_missing()
            data = json.loads(allowlist_path.read_text(encoding="utf-8"))
            want = expected.get("bootstrap_users")
            if want is not None and sorted(data.get("users", [])) != sorted(want):
                return False, f"bootstrap users mismatch: {data}"

        for uid in expected.get("allowed") or []:
            ev = SimpleNamespace(platform="telegram", sender_id=str(uid), sender_name=f"u{uid}")
            v = module._pre_gateway_dispatch(ev)
            if v is not None:
                return False, f"user {uid} should be allowed, got {v!r}"
        for uid in expected.get("rejected") or []:
            ev = SimpleNamespace(platform="telegram", sender_id=str(uid), sender_name=f"u{uid}")
            v = module._pre_gateway_dispatch(ev)
            if not isinstance(v, dict) or v.get("action") != "skip":
                return False, f"user {uid} should be rejected, got {v!r}"
        return True, "ok"


# ---------------------------------------------------------------------------
# Suite: rate-limit
# ---------------------------------------------------------------------------

def run_rate_limit(fixture: dict) -> tuple[bool, str]:
    """Exercise botji-rate-limit's sliding-window throttle.

    inputs.per_minute:                  throttle threshold (default 30)
    inputs.per_hour:                    throttle threshold (default 200)
    inputs.user_id:                     Telegram sender id used for each call
    inputs.burst_count:                 number of sequential calls
    inputs.different_user_id:           optional — sent after the burst to confirm isolation
    expected.allowed_count:             how many of the burst should be allowed
    expected.rejected_at_index:         zero-indexed position of first rejection (optional)
    expected.rejection_reason_contains: substring of the skip reason (optional)
    expected.different_user_allowed:    bool — must different_user_id pass after burst?
    """
    plugin_path = _plugin_path("botji-rate-limit")
    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}

    os.environ["BOTJI_RATE_LIMIT_PER_MIN"] = str(inputs.get("per_minute", 30))
    os.environ["BOTJI_RATE_LIMIT_PER_HOUR"] = str(inputs.get("per_hour", 200))

    module = _load_module(plugin_path, f"botji_rate_h_{uuid.uuid4().hex[:8]}")
    # Reset module-level limiter so each fixture builds a fresh limiter from
    # the env vars set above.
    if hasattr(module, "_limiter"):
        module._limiter = None

    user_id = str(inputs.get("user_id", "12345"))
    burst = int(inputs.get("burst_count", 1))

    allowed = 0
    first_rejection_index: int | None = None
    first_rejection_reason: str | None = None
    for i in range(burst):
        ev = SimpleNamespace(platform="telegram", sender_id=user_id, sender_name=f"u{user_id}")
        v = module._pre_gateway_dispatch(ev)
        if v is None:
            allowed += 1
        else:
            if first_rejection_index is None:
                first_rejection_index = i
                first_rejection_reason = v.get("reason") if isinstance(v, dict) else None

    want_allowed = expected.get("allowed_count")
    if want_allowed is not None and allowed != want_allowed:
        return False, f"allowed_count mismatch: got {allowed}, want {want_allowed}"

    want_index = expected.get("rejected_at_index")
    if want_index is not None and first_rejection_index != want_index:
        return False, f"rejected_at_index mismatch: got {first_rejection_index}, want {want_index}"

    want_reason = expected.get("rejection_reason_contains")
    if want_reason and (first_rejection_reason is None or want_reason not in first_rejection_reason):
        return False, f"reason did not contain {want_reason!r}: {first_rejection_reason!r}"

    other_id = inputs.get("different_user_id")
    if other_id is not None:
        ev = SimpleNamespace(platform="telegram", sender_id=str(other_id), sender_name=f"u{other_id}")
        v = module._pre_gateway_dispatch(ev)
        want_other = expected.get("different_user_allowed")
        if want_other is True and v is not None:
            return False, f"different_user {other_id} should pass, got {v!r}"
        if want_other is False and v is None:
            return False, f"different_user {other_id} should be blocked, got pass"

    return True, "ok"


# ---------------------------------------------------------------------------
# Suite: contract
# ---------------------------------------------------------------------------

def run_contract(fixture: dict) -> tuple[bool, str]:
    """Generate a Prompt v1 contract and assert structural invariants.

    inputs.truth_mode:               value passed through to contract
    expected.required_keys:          list of top-level keys that must exist
    expected.truth_mode:             exact match
    expected.contract_id_prefix:     must start with this string
    expected.forbidden_routes_contains: substring required in artifact_fidelity.forbidden_routes
    """
    import datetime as dt

    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}
    truth_mode = inputs.get("truth_mode") or os.environ.get("BOTJI_DEFAULT_TRUTH_MODE", "fidelity")

    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    contract_id = f"prompt-{now.strftime('%Y%m%dT%H%M%SZ')}-{uuid.uuid4().hex[:8]}"
    contract = {
        "contract_id": contract_id,
        "version": "Prompt v1",
        "created_at": now.isoformat().replace("+00:00", "Z"),
        "tier": "substantive",
        "user_intent": "",
        "truth_mode": truth_mode,
        "sources": [],
        "authority_order": [],
        "preserve": [],
        "change": [],
        "execution_plan": [],
        "missing_inputs": [],
        "risk_level": "medium",
        "approval_required": False,
        "artifact_lineage": {
            "parent_artifact_id": None,
            "output_artifact_id": None,
            "version_label": "Prompt v1",
            "change_reason": "",
        },
        "artifact_fidelity": {
            "source_artifact_ids": [],
            "normalized_schema_ids": [],
            "selected_route": "exact_copy",
            "forbidden_routes": ["prompt_only_generation"],
            "hard_requirements": [
                "Preserve source artifacts byte-for-byte unless the user explicitly authorizes a transform route.",
            ],
            "advisory_preferences": [],
            "comparator_required": False,
            "comparator_status": "not_applicable",
            "review_required": True,
        },
        "artifact_refs": [],
        "allowed_operations": ["exact_copy"],
        "selected_adapter": "auto",
        "evidence_required": False,
        "unknown_policy": "state_unknown",
        "output_expectation": {"type": "answer", "review_required": True},
        "notes": "",
    }
    with tempfile.TemporaryDirectory(prefix="botji-h-contract-") as tmp:
        out_path = Path(tmp) / f"{contract_id}.json"
        out_path.write_text(json.dumps(contract, indent=2), encoding="utf-8")
        reloaded = json.loads(out_path.read_text(encoding="utf-8"))

    for key in expected.get("required_keys") or []:
        if key not in reloaded:
            return False, f"missing required key: {key}"
    if "truth_mode" in expected and reloaded["truth_mode"] != expected["truth_mode"]:
        return False, f"truth_mode {reloaded['truth_mode']!r} != {expected['truth_mode']!r}"
    if "contract_id_prefix" in expected and not reloaded["contract_id"].startswith(expected["contract_id_prefix"]):
        return False, f"contract_id {reloaded['contract_id']!r} missing prefix {expected['contract_id_prefix']!r}"
    needle = expected.get("forbidden_routes_contains")
    if needle and needle not in reloaded.get("artifact_fidelity", {}).get("forbidden_routes", []):
        return False, f"forbidden_routes missing {needle!r}"
    return True, "ok"


# ---------------------------------------------------------------------------
# Suite: fidelity-guard
# ---------------------------------------------------------------------------

def run_fidelity_guard(fixture: dict) -> tuple[bool, str]:
    """Exercise botji-artifacts _guardrails or _vision module.

    inputs.guard: "current_turn" or "vision"
    See _run_current_turn_guard / _run_vision_guard for per-guard details.
    """
    plugin_root = _plugin_path("botji-artifacts").parent
    if not (plugin_root / "__init__.py").is_file():
        return False, f"botji-artifacts plugin not found at {plugin_root}"

    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}
    guard = inputs.get("guard")
    if guard == "current_turn":
        return _run_current_turn_guard(plugin_root, inputs, expected)
    if guard == "vision":
        return _run_vision_guard(plugin_root, inputs, expected)
    return False, f"unknown guard: {guard!r}"


def _run_current_turn_guard(plugin_root: Path, inputs: dict, expected: dict) -> tuple[bool, str]:
    import hashlib

    if str(plugin_root) not in sys.path:
        sys.path.insert(0, str(plugin_root))
    from _guardrails import apply_current_turn_source_guard  # type: ignore

    with tempfile.TemporaryDirectory(prefix="botji-h-fid-") as tmp:
        home = Path(tmp)
        os.environ["HERMES_HOME"] = str(home)
        os.environ["BOTJI_ARTIFACT_ROOT"] = str(home / "artifacts")

        current_bytes = inputs.get("current_image_bytes", "current-image").encode("utf-8")
        registry_bytes = inputs.get("registry_bytes", "stale-image").encode("utf-8")
        artifact_id = inputs.get("artifact_id", "art_test")
        session_id = inputs.get("session_id", "session_test")

        current = home / "image_cache" / "current.jpg"
        stale = home / "image_cache" / "stale.jpg"
        copied = home / "artifacts" / "sources" / artifact_id / "stale.jpg"
        current.parent.mkdir(parents=True, exist_ok=True)
        copied.parent.mkdir(parents=True, exist_ok=True)
        current.write_bytes(current_bytes)
        stale.write_bytes(registry_bytes)
        copied.write_bytes(registry_bytes)

        session_path = home / "sessions" / f"{session_id}.jsonl"
        session_path.parent.mkdir(parents=True, exist_ok=True)
        session_path.write_text(json.dumps({
            "role": "user",
            "content": [{"type": "text", "text": f"Make 3d\n\n[Image attached at: {current}]"}],
        }) + "\n", encoding="utf-8")

        sha = hashlib.sha256(registry_bytes).hexdigest()
        idx = home / "artifacts" / "index" / "artifacts.jsonl"
        idx.parent.mkdir(parents=True, exist_ok=True)
        idx.write_text(json.dumps({
            "artifact_id": artifact_id,
            "role": "source",
            "path": str(copied),
            "original_path": str(stale),
            "adapter": "image",
            "sha256": sha,
            "parents": [],
            "evidence_ids": [],
        }) + "\n", encoding="utf-8")

        review = _base_review(artifact_id)
        guarded, changed = apply_current_turn_source_guard(review, session_id)

        if "changed" in expected and bool(changed) != bool(expected["changed"]):
            return False, f"changed: expected {expected['changed']}, got {changed}"
        if "delivery_gate" in expected and guarded.get("delivery_gate") != expected["delivery_gate"]:
            return False, f"delivery_gate {guarded.get('delivery_gate')!r} != {expected['delivery_gate']!r}"
        prefix = expected.get("primary_blocker_prefix")
        if prefix:
            actual = guarded.get("primary_blocker") or ""
            if not isinstance(actual, str) or not actual.startswith(prefix):
                return False, f"primary_blocker {actual!r} missing prefix {prefix!r}"
        return True, "ok"


def _run_vision_guard(plugin_root: Path, inputs: dict, expected: dict) -> tuple[bool, str]:
    if str(plugin_root) not in sys.path:
        sys.path.insert(0, str(plugin_root))
    from _vision import _assess_vision_payload  # type: ignore

    requirements = list(inputs.get("requirements") or [])
    payload = {"comparison": json.dumps(inputs.get("comparison") or {})}
    assessed = _assess_vision_payload(payload, requirements)

    if "verdict" in expected and assessed.get("verdict") != expected["verdict"]:
        return False, f"verdict {assessed.get('verdict')!r} != {expected['verdict']!r}"
    for needle in expected.get("blockers_contain") or []:
        blockers = assessed.get("blockers") or []
        if not any(needle in str(item) for item in blockers):
            return False, f"blockers missing {needle!r}: {blockers}"
    return True, "ok"


def _base_review(source_id: str) -> dict:
    return {
        "review_id": "review_test",
        "reviewed_output_ref": "art_output",
        "verdict": "pass",
        "delivery_gate": "clear",
        "recommended_action": "deliver",
        "primary_blocker": None,
        "retry_guidance": None,
        "axes": [],
        "blockers": [],
        "required_corrections": [],
        "artifact_context": {
            "source_artifact_ids": [source_id],
            "output_artifact_id": "art_output",
            "evidence_ids": [],
        },
        "fidelity_scores": {
            "transform_contract_fidelity_percent": 100,
            "preservation_target": "source_constraint_preservation",
        },
    }


# ---------------------------------------------------------------------------
# Suite: id-family (NEW)
# ---------------------------------------------------------------------------

def run_id_family(fixture: dict) -> tuple[bool, str]:
    """Assert tools reject mixing pipeline ID families.

    inputs.scenario:
      mixed_receipt_sources         - legacy art_ in receipt while turn has native src_
      artifact_write_unknown_parent - unknown parent ID fails artifact_write
      receipt_unknown_source        - receipt_record fails when source_ids is fabricated
      out_id_in_source_slot         - placing out_ in source_ids triggers parent mismatch
      pre_hook_stale_art            - pre_tool_call hook rejects stale art_ source
      pre_hook_mixed_family         - pre_tool_call hook rejects art_ + src_ in same call
      pre_hook_over_budget          - pre_tool_call hook rejects 3rd edit_image in a turn
      pre_hook_variants_override    - user_authorized_variants bypasses transform cap
      pre_hook_happy_path           - vanilla call passes all three predicates
    """
    plugin_path = _plugin_path("botji-core")
    with tempfile.TemporaryDirectory(prefix="botji-h-idfam-") as tmp:
        home = Path(tmp)
        os.environ["HERMES_HOME"] = str(home)
        os.environ["BOTJI_CORE_ROOT"] = str(home / "botji-core")
        os.environ["BOTJI_ARTIFACT_ROOT"] = str(home / "artifacts")
        ctx = _FakeContext()
        module = _load_module(plugin_path, f"botji_idfam_h_{uuid.uuid4().hex[:8]}")
        module.register(ctx)

        inputs = fixture.get("inputs") or {}
        expected = fixture.get("expected") or {}
        scenario = inputs.get("scenario")

        incoming = home / "incoming"
        incoming.mkdir(parents=True, exist_ok=True)
        src_file = incoming / "src.txt"
        src_file.write_text("src-bytes", encoding="utf-8")
        out_file = incoming / "out.txt"
        out_file.write_text("out-bytes", encoding="utf-8")

        if scenario == "mixed_receipt_sources":
            # Build a full legacy source+output pair in the legacy index so the
            # output_parent_mismatch check passes (output parents IS art_legacy)
            # and the mixed_pipeline_source check is the one that fires.
            legacy_src_path = home / "artifacts" / "sources" / "art_legacy" / "src.txt"
            legacy_out_path = home / "artifacts" / "outputs" / "art_legacy_out" / "out.txt"
            legacy_src_path.parent.mkdir(parents=True, exist_ok=True)
            legacy_out_path.parent.mkdir(parents=True, exist_ok=True)
            legacy_src_path.write_text("legacy-src", encoding="utf-8")
            legacy_out_path.write_text("legacy-out", encoding="utf-8")
            idx = home / "artifacts" / "index" / "artifacts.jsonl"
            idx.parent.mkdir(parents=True, exist_ok=True)
            idx.write_text(
                json.dumps({
                    "artifact_id": "art_legacy", "role": "source",
                    "path": str(legacy_src_path), "parents": [],
                    "created_at": "2026-05-20T00:00:00Z",
                }) + "\n" +
                json.dumps({
                    "artifact_id": "art_legacy_out", "role": "output",
                    "path": str(legacy_out_path), "parents": ["art_legacy"],
                    "created_at": "2026-05-20T00:01:00Z",
                }) + "\n",
                encoding="utf-8",
            )

            # Native src_ registration on the same turn flips the substrate
            # into "current turn has native sources" mode.
            native = _call_tool(ctx, "source_register", {
                "path": str(src_file), "current_turn_id": "turn-mixed",
                "role": "source", "declared_type": "text",
            })
            if not native.get("success") or not native["source"]["artifact_id"].startswith("src_"):
                return False, f"native source registration failed: {native}"

            # Receipt cites the legacy art_ source while turn has a native src_.
            # Output is the legacy out_ (parents = [art_legacy]) so parent check passes.
            receipt = _call_tool(ctx, "receipt_record", {
                "source_ids": ["art_legacy"], "output_id": "art_legacy_out",
                "route": "legacy-while-native-present", "status": "pass",
                "current_turn_id": "turn-mixed",
            })
            gate = _call_tool(ctx, "delivery_gate", {"receipt_id": receipt["receipt_id"]})
            return _check_expected(gate, expected)

        if scenario == "artifact_write_unknown_parent":
            bogus = inputs.get("parent_id", "src_does_not_exist")
            written = _call_tool(ctx, "artifact_write", {
                "path": str(out_file), "parents": [bogus],
                "current_turn_id": "turn-bogus", "claim_level": "draft",
            })
            if written.get("success"):
                return False, f"expected failure, got success: {written}"
            needle = expected.get("error_contains")
            if needle and needle not in str(written.get("error") or ""):
                return False, f"error missing {needle!r}: {written.get('error')!r}"
            return True, "ok"

        if scenario == "receipt_unknown_source":
            bogus = inputs.get("source_id", "out_pretending_to_be_source")
            native = _call_tool(ctx, "source_register", {
                "path": str(src_file), "current_turn_id": "turn-x",
                "role": "source", "declared_type": "text",
            })
            written = _call_tool(ctx, "artifact_write", {
                "path": str(out_file), "parents": [native["source"]["artifact_id"]],
                "current_turn_id": "turn-x", "claim_level": "draft",
            })
            receipt = _call_tool(ctx, "receipt_record", {
                "source_ids": [bogus], "output_id": written["artifact"]["artifact_id"],
                "route": "bogus", "status": "pass",
                "current_turn_id": "turn-x",
            })
            if receipt.get("success"):
                return False, f"expected receipt failure, got: {receipt}"
            needle = expected.get("error_contains")
            if needle and needle not in str(receipt.get("error") or ""):
                return False, f"error missing {needle!r}: {receipt.get('error')!r}"
            return True, "ok"

        if scenario == "out_id_in_source_slot":
            native = _call_tool(ctx, "source_register", {
                "path": str(src_file), "current_turn_id": "turn-y",
                "role": "source", "declared_type": "text",
            })
            written = _call_tool(ctx, "artifact_write", {
                "path": str(out_file), "parents": [native["source"]["artifact_id"]],
                "current_turn_id": "turn-y", "claim_level": "draft",
            })
            out_id = written["artifact"]["artifact_id"]
            receipt = _call_tool(ctx, "receipt_record", {
                "source_ids": [out_id], "output_id": out_id,
                "route": "swapped", "status": "pass",
                "current_turn_id": "turn-y",
            })
            gate = _call_tool(ctx, "delivery_gate", {"receipt_id": receipt["receipt_id"]})
            return _check_expected(gate, expected)

        if scenario == "pre_hook_stale_art":
            # Seed a legacy art_ record tagged with an older turn id.
            idx = home / "artifacts" / "index" / "artifacts.jsonl"
            idx.parent.mkdir(parents=True, exist_ok=True)
            idx.write_text(json.dumps({
                "artifact_id": "art_stale_xyz", "role": "source",
                "current_turn_id": "turn-old",
                "path": str(src_file),
            }) + "\n", encoding="utf-8")
            return _check_hook_result(ctx, fixture, {
                "source_ids": ["art_stale_xyz"], "current_turn_id": "turn-new",
            })

        if scenario == "pre_hook_mixed_family":
            return _check_hook_result(ctx, fixture, {
                "source_ids": ["art_legacy_abc", "src_native_def"],
                "current_turn_id": "turn-z",
            })

        if scenario == "pre_hook_over_budget":
            # Reset module-level counter so prior fixtures cannot pollute it.
            from importlib import import_module
            hooks_pkg = import_module(module.__name__ + ".hooks.stale_id_block")
            hooks_pkg._reset_transform_counts()
            # First two calls fill the budget.
            for _ in range(2):
                _invoke_pre_tool_call(ctx, "artifact_transform", {
                    "operation": "edit_image", "current_turn_id": "turn-b",
                }, "session-b")
            return _check_hook_result(
                ctx, fixture,
                {"operation": "edit_image", "current_turn_id": "turn-b"},
                tool_name="artifact_transform", session_id="session-b",
            )

        if scenario == "pre_hook_variants_override":
            from importlib import import_module
            hooks_pkg = import_module(module.__name__ + ".hooks.stale_id_block")
            hooks_pkg._reset_transform_counts()
            # Pre-fill the budget so a non-authorized call would block.
            for _ in range(2):
                _invoke_pre_tool_call(ctx, "artifact_transform", {
                    "operation": "edit_image", "current_turn_id": "turn-v",
                }, "session-v")
            return _check_hook_result(
                ctx, fixture,
                {"operation": "edit_image", "current_turn_id": "turn-v",
                 "user_authorized_variants": 4},
                tool_name="artifact_transform", session_id="session-v",
            )

        if scenario == "pre_hook_happy_path":
            return _check_hook_result(ctx, fixture, {
                "source_ids": ["src_alone_abc"], "current_turn_id": "turn-h",
            })

        return False, f"unknown scenario: {scenario!r}"


# ---------------------------------------------------------------------------
# Suite: cron — validate cron yaml seeds in cron/*.yaml
# ---------------------------------------------------------------------------

def run_cron(fixture: dict) -> tuple[bool, str]:
    """Validate a cron yaml seed at inputs.cron_file (path relative to repo root).

    Asserts the yaml is a mapping with required create_job fields (name,
    schedule, prompt — mirroring hermes-agent/cron/jobs.py), the schedule
    is a non-empty string, and when no_agent is set the referenced script
    exists under cron/scripts/. `expected.{no_agent,name,schedule,script}`
    are asserted exactly when provided.
    """
    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}

    rel = inputs.get("cron_file")
    if not rel:
        return False, "inputs.cron_file is required"
    # Deployed tenants seed cron yamls into $HERMES_HOME/cron/. Probe there
    # first (filename basename), fall back to repo-relative for dev runs.
    # Previous repo-only resolution failed in-container because __file__
    # resolves to /usr/local/bin/botji-harness, giving /usr/cron/... .
    home = Path(os.environ.get("HERMES_HOME", "/opt/data"))
    cron_path = home / "cron" / Path(rel).name
    if not cron_path.is_file():
        cron_path = Path(__file__).resolve().parents[2] / rel
    if not cron_path.is_file():
        return False, f"cron yaml not found: {cron_path}"

    try:
        with cron_path.open("r", encoding="utf-8") as fh:
            spec = yaml.safe_load(fh)
    except yaml.YAMLError as exc:
        return False, f"yaml parse error: {exc}"
    if not isinstance(spec, dict):
        return False, f"cron yaml is not a mapping: got {type(spec).__name__}"

    for key in ("name", "schedule", "prompt"):
        if key not in spec:
            return False, f"missing required field: {key!r}"
    if not isinstance(spec["schedule"], str) or not spec["schedule"].strip():
        return False, f"schedule must be non-empty string, got {spec['schedule']!r}"

    no_agent = bool(spec.get("no_agent"))
    if no_agent:
        script = spec.get("script")
        if not isinstance(script, str) or not script.strip():
            return False, "no_agent=true requires a non-empty script"
        # sync_code_components copies cron/scripts/* into $DATA_DIR/scripts/.
        if not (repo_root / "cron" / "scripts" / script).is_file():
            return False, f"script {script!r} not found under cron/scripts/"

    for key in ("no_agent", "name", "schedule", "script"):
        if key not in expected:
            continue
        got = no_agent if key == "no_agent" else spec.get(key)
        if got != expected[key]:
            return False, f"{key} {got!r} != expected {expected[key]!r}"
    return True, "ok"


# ---------------------------------------------------------------------------
# Suite: delivery — transform_llm_output enforcement on final reply text
# ---------------------------------------------------------------------------

def run_delivery(fixture: dict) -> tuple[bool, str]:
    """Seed receipts/sources/legacy index, call transform_llm_output, assert.

    inputs.receipts:         records appended to botji-core/index/receipts.jsonl
    inputs.sources:          records appended to botji-core/index/sources.jsonl
    inputs.legacy_artifacts: legacy art_* records (artifact_id,
                             current_turn_id, role, content)
    inputs.response_text:    text passed to the hook
    expected.passthrough:    when true, hook MUST return None
    expected.contains:       substring required in the rewritten string
    expected.not_contains:   substring forbidden in the rewritten string
    """
    from importlib import import_module
    plugin_path = _plugin_path("botji-core")
    with tempfile.TemporaryDirectory(prefix="botji-h-deliv-") as tmp:
        home = Path(tmp)
        os.environ["HERMES_HOME"] = str(home)
        os.environ["BOTJI_CORE_ROOT"] = str(home / "botji-core")
        os.environ["BOTJI_ARTIFACT_ROOT"] = str(home / "artifacts")
        ctx = _FakeContext()
        module = _load_module(plugin_path, f"botji_deliv_h_{uuid.uuid4().hex[:8]}")
        module.register(ctx)

        inputs = fixture.get("inputs") or {}
        expected = fixture.get("expected") or {}
        core_idx = home / "botji-core" / "index"
        core_idx.mkdir(parents=True, exist_ok=True)
        for kind in ("receipts", "sources"):
            for record in (inputs.get(kind) or []):
                with (core_idx / f"{kind}.jsonl").open("a", encoding="utf-8") as fh:
                    fh.write(json.dumps(record) + "\n")
        for entry in (inputs.get("legacy_artifacts") or []):
            art_id = entry["artifact_id"]
            data_path = home / "artifacts" / "legacy" / art_id / "data.txt"
            data_path.parent.mkdir(parents=True, exist_ok=True)
            data_path.write_text(entry.get("content", "legacy"), encoding="utf-8")
            legacy_idx = home / "artifacts" / "index" / "artifacts.jsonl"
            legacy_idx.parent.mkdir(parents=True, exist_ok=True)
            with legacy_idx.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps({
                    "artifact_id": art_id,
                    "role": entry.get("role", "source"),
                    "current_turn_id": entry.get("current_turn_id"),
                    "path": str(data_path),
                    "parents": entry.get("parents", []),
                    "created_at": entry.get("created_at", "2026-05-20T00:00:00Z"),
                }) + "\n")

        hooks_pkg = import_module(module.__name__ + ".hooks.delivery_check")
        got = hooks_pkg.transform_llm_output(
            response_text=inputs.get("response_text", ""),
            session_id=inputs.get("session_id", "session-d"),
        )
        if expected.get("passthrough"):
            return (True, "ok") if got is None else (False, f"expected passthrough, got {got!r}")
        if not isinstance(got, str):
            return False, f"expected rewrite string, got {got!r}"
        needle = expected.get("contains")
        if needle and needle not in got:
            return False, f"{needle!r} not in {got!r}"
        forbidden = expected.get("not_contains")
        if forbidden and forbidden in got:
            return False, f"forbidden {forbidden!r} found in {got!r}"
        return True, "ok"


# ---------------------------------------------------------------------------
# Suite: audit — append-only audit log written by metrics/hooks.py
# ---------------------------------------------------------------------------

def run_audit(fixture: dict) -> tuple[bool, str]:
    """Invoke metrics.hooks.on_post_tool_call directly and assert JSONL audit
    output. Bypasses the Prometheus exporter (which would need a real port
    bind and prometheus_client dep) by stubbing `_started=True` and replacing
    the metric singletons with no-op objects. Audit logic in `_audit_write`
    is independent of metrics emission, so this validates the audit path.

    inputs.tenant:          BOTJI_TENANT_ID; default "test-tenant"
    inputs.tool_name:       tool name to audit
    inputs.args:            args dict passed to hook
    inputs.result:          tool result dict or string
    inputs.session_id:      session id passed to hook
    inputs.tool_call_id:    tool call id
    inputs.break_audit:     when true, point HERMES_HOME at an unwritable
                            sentinel so _audit_write must fail; the hook
                            must still swallow the exception (fail-open).
    expected.record_count:  expected number of audit lines
    expected.result_status: "success" or "error"
    expected.session_id:    expected session_id in the record
    expected.args_hash_present: bool
    expected.args_kinds:    dict; expected args_kinds payload (exact match)
    expected.summary_excludes: list[str] of substrings forbidden in result_summary
    expected.summary_includes_redaction: bool — at least one <redacted:secret>
    """
    from importlib import import_module
    plugin_path = _plugin_path("botji-core")
    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}
    with tempfile.TemporaryDirectory(prefix="botji-h-audit-") as tmp:
        home = Path(tmp)
        os.environ["HERMES_HOME"] = str(home)
        os.environ["BOTJI_TENANT_ID"] = inputs.get("tenant", "test-tenant")
        os.environ["BOTJI_CORE_ROOT"] = str(home / "botji-core")
        ctx = _FakeContext()
        module = _load_module(plugin_path, f"botji_audit_h_{uuid.uuid4().hex[:8]}")
        module.register(ctx)

        mod_metrics = import_module(module.__name__ + ".metrics")
        hooks_mod = import_module(module.__name__ + ".metrics.hooks")
        exp_mod = import_module(module.__name__ + ".metrics.exporter")

        class _NoopLabel:
            def inc(self, *_a, **_k): pass
            def observe(self, *_a, **_k): pass
            def set(self, *_a, **_k): pass
        class _NoopMetric:
            def labels(self, **_k): return _NoopLabel()
        for attr in ("delivery_gate_total", "artifact_transform_total",
                     "artifact_transform_duration_seconds", "receipt_record_total",
                     "tool_error_total", "container_info"):
            setattr(exp_mod, attr, _NoopMetric())
        exp_mod._started = True
        exp_mod.TENANT = inputs.get("tenant", "test-tenant")
        hooks_mod._AUDIT_DONE.clear()

        if inputs.get("break_audit"):
            # Replace HERMES_HOME with a file path so mkdir fails.
            broken = home / "not_a_dir"
            broken.write_text("blocker", encoding="utf-8")
            os.environ["HERMES_HOME"] = str(broken)

        tool_name = inputs.get("tool_name", "artifact_register")
        args = inputs.get("args") or {}
        result = inputs.get("result")
        tool_call_id = inputs.get("tool_call_id", "tc-audit-1")
        session_id = inputs.get("session_id", "session-audit")

        # Run the real hook end-to-end so we exercise the same code path as
        # production (pre + post). Any audit error must be swallowed.
        hooks_mod.on_pre_tool_call(tool_name=tool_name, tool_call_id=tool_call_id)
        hooks_mod.on_post_tool_call(
            tool_name=tool_name, args=args, result=result,
            tool_call_id=tool_call_id, session_id=session_id)

        audit_path = home / "audit" / f"{exp_mod.TENANT}-substrate.jsonl"
        lines: list[dict] = []
        if audit_path.is_file():
            for raw in audit_path.read_text(encoding="utf-8").splitlines():
                if raw.strip():
                    lines.append(json.loads(raw))

        want_count = expected.get("record_count")
        if want_count is not None and len(lines) != want_count:
            return False, f"expected {want_count} records, got {len(lines)}: {lines!r}"

        if not lines:
            return True, "ok"
        rec = lines[0]
        if expected.get("result_status") and rec.get("result_status") != expected["result_status"]:
            return False, f"result_status {rec.get('result_status')!r} != {expected['result_status']!r}"
        if expected.get("session_id") is not None and rec.get("session_id") != expected["session_id"]:
            return False, f"session_id {rec.get('session_id')!r} != {expected['session_id']!r}"
        if expected.get("args_hash_present") and not isinstance(rec.get("args_hash"), str):
            return False, f"args_hash missing or not a string: {rec.get('args_hash')!r}"
        if expected.get("args_kinds") is not None and rec.get("args_kinds") != expected["args_kinds"]:
            return False, f"args_kinds {rec.get('args_kinds')!r} != {expected['args_kinds']!r}"
        for needle in expected.get("summary_excludes") or []:
            if needle in (rec.get("result_summary") or ""):
                return False, f"summary leaks forbidden {needle!r}: {rec.get('result_summary')!r}"
        if expected.get("summary_includes_redaction") and "<redacted:" not in (rec.get("result_summary") or ""):
            return False, f"summary missing redaction marker: {rec.get('result_summary')!r}"
        for key in ("timestamp", "tool", "tenant", "duration_ms"):
            if key not in rec:
                return False, f"record missing required field {key!r}: {rec!r}"
        return True, "ok"


# ---------------------------------------------------------------------------
# Suite: render — validate Kanban workflow templates + skill cross-references
# ---------------------------------------------------------------------------

def run_render(fixture: dict) -> tuple[bool, str]:
    """Validate a Kanban workflow template seed under seed/hermes/kanban/workflows/.

    The fixture points at `inputs.template_file` (path relative to repo root).
    Asserts the yaml parses as a mapping with required fields (id, steps), each
    step has a unique `key`, the declared `applies_when` shape is sane, and any
    `expected.referencing_skills` actually mention the template id and the
    step keys named under `expected.must_reference_steps`. This catches skill
    prose silently drifting away from the template — they share a contract,
    so they break together or not at all.
    """
    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}

    rel = inputs.get("template_file")
    if not rel:
        return False, "inputs.template_file is required"
    # Deployed tenants seed kanban templates into $HERMES_HOME/kanban/workflows/.
    # Probe there first by basename, fall back to repo-relative for dev runs.
    home = Path(os.environ.get("HERMES_HOME", "/opt/data"))
    tpath = home / "kanban" / "workflows" / Path(rel).name
    if not tpath.is_file():
        tpath = Path(__file__).resolve().parents[2] / rel
    if not tpath.is_file():
        return False, f"workflow template not found: {tpath}"

    try:
        with tpath.open("r", encoding="utf-8") as fh:
            spec = yaml.safe_load(fh)
    except yaml.YAMLError as exc:
        return False, f"yaml parse error: {exc}"
    if not isinstance(spec, dict):
        return False, f"template is not a mapping: got {type(spec).__name__}"

    for key in ("id", "steps"):
        if key not in spec:
            return False, f"missing required field: {key!r}"
    steps = spec.get("steps")
    if not isinstance(steps, list) or not steps:
        return False, "steps must be a non-empty list"
    step_keys: list[str] = []
    for idx, step in enumerate(steps):
        if not isinstance(step, dict):
            return False, f"step[{idx}] is not a mapping"
        skey = step.get("key")
        if not isinstance(skey, str) or not skey.strip():
            return False, f"step[{idx}] missing 'key'"
        if skey in step_keys:
            return False, f"duplicate step key: {skey!r}"
        step_keys.append(skey)

    template_id = spec["id"]
    exp_id = expected.get("id")
    if exp_id is not None and template_id != exp_id:
        return False, f"id {template_id!r} != expected {exp_id!r}"
    exp_steps = expected.get("step_keys")
    if exp_steps is not None and step_keys != list(exp_steps):
        return False, f"step keys {step_keys!r} != expected {list(exp_steps)!r}"

    # Cross-reference check: each named skill file mentions the template
    # (by filename or id). Catches silent drift between SKILL.md prose and
    # the template — see docs/OPERATIONS.md "Kanban-backed render retry".
    # `referencing_skills_with_steps` is the stricter list — those files
    # must also name every step key under `must_reference_steps`.
    must_ref_steps = expected.get("must_reference_steps") or []
    for skill_rel in expected.get("referencing_skills") or []:
        spath = repo_root / skill_rel
        if not spath.is_file():
            return False, f"referencing skill not found: {spath}"
        body = spath.read_text(encoding="utf-8")
        if "render_retry.yaml" not in body and template_id not in body:
            return False, f"{skill_rel} does not reference template id or filename"
    for skill_rel in expected.get("referencing_skills_with_steps") or []:
        spath = repo_root / skill_rel
        if not spath.is_file():
            return False, f"referencing skill not found: {spath}"
        body = spath.read_text(encoding="utf-8")
        for sk in must_ref_steps:
            if sk not in body:
                return False, f"{skill_rel} missing step reference: {sk}"
    return True, "ok"


# ---------------------------------------------------------------------------
# Suite: manifest — typed manifest v2 schema + back-compat converter tests
# ---------------------------------------------------------------------------

def run_manifest(fixture: dict) -> tuple[bool, str]:
    """Validate the typed manifest v2 scaffold (Phase C1).

    inputs.scenario:
      roundtrip        - v1 prose → typed → v1 prose; assert structural fields
      schema_validate  - directly-written typed manifest against JSON Schema
      pydantic_validate - directly-written typed manifest through Pydantic
    See tests/fixtures/manifest/*.yaml for per-scenario inputs/expected.
    """
    plugin_root = _plugin_path("botji-artifacts").parent
    if str(plugin_root) not in sys.path:
        sys.path.insert(0, str(plugin_root))
    inputs = fixture.get("inputs") or {}
    expected = fixture.get("expected") or {}
    scenario = inputs.get("scenario")

    if scenario == "roundtrip":
        from _manifest_v2_compat import prose_to_typed, typed_to_prose  # type: ignore
        v1 = inputs.get("v1_manifest") or {}
        typed = prose_to_typed(v1)
        back = typed_to_prose(typed)
        if expected.get("element_count_preserved") and back["element_count"] != v1.get("element_count"):
            return False, f"element_count {back['element_count']} != v1 {v1.get('element_count')}"
        if expected.get("layout_hints_preserved") and list(back["layout_hints"]) != list(v1.get("layout_hints") or []):
            return False, f"layout_hints drift: {back['layout_hints']} vs {v1.get('layout_hints')}"
        if expected.get("fidelity_requirements_preserved") and list(back["fidelity_requirements"]) != list(v1.get("fidelity_requirements") or []):
            return False, "fidelity_requirements drift"
        if expected.get("adjacency_count_preserved") and len(back["adjacency_constraints"]) != len(v1.get("adjacency_constraints") or []):
            return False, "adjacency_constraints count drift"
        if expected.get("opening_count_preserved") and len(back["opening_constraints"]) != len(v1.get("opening_constraints") or []):
            return False, "opening_constraints count drift"
        if expected.get("zones_preserved"):
            for v1_el, v2_el in zip(v1.get("elements") or [], back["elements"]):
                # The typed pipeline normalizes zone strings; check it survives
                # round-trip when the v1 zone was already a canonical Zone enum.
                if v1_el.get("wall_or_zone") in {"left_wall", "right_wall", "back_wall", "front_wall", "floor", "ceiling", "center", "island"}:
                    if v2_el["wall_or_zone"] != v1_el["wall_or_zone"]:
                        return False, f"zone drift: {v2_el['wall_or_zone']} != {v1_el['wall_or_zone']}"
        return True, "ok"

    if scenario == "schema_validate":
        from jsonschema import Draft202012Validator  # type: ignore
        repo_root = Path(__file__).resolve().parents[2]
        schema_path = repo_root / "seed" / "hermes" / "schemas" / "manifest_v2.schema.json"
        schema = json.loads(schema_path.read_text(encoding="utf-8"))
        validator = Draft202012Validator(schema)
        errs = list(validator.iter_errors(inputs.get("typed_manifest") or {}))
        valid = not errs
        want = expected.get("schema_valid")
        if want is True and not valid:
            return False, f"expected valid, got errors: {[e.message for e in errs[:3]]}"
        if want is False and valid:
            return False, "expected schema_valid=false, but passed"
        needle = expected.get("failing_field")
        if needle and not any(needle in e.message or needle in str(list(e.absolute_path)) for e in errs):
            return False, f"errors do not mention {needle!r}: {[e.message for e in errs[:3]]}"
        return True, "ok"

    if scenario == "pydantic_validate":
        from pydantic import ValidationError as _VE  # type: ignore
        from _manifest_v2 import Manifest  # type: ignore
        try:
            Manifest.model_validate(inputs.get("typed_manifest") or {})
            valid, err_text = True, ""
        except _VE as exc:
            valid, err_text = False, str(exc)
        want = expected.get("pydantic_valid")
        if want is True and not valid:
            return False, f"expected valid, got: {err_text[:200]}"
        if want is False and valid:
            return False, "expected pydantic_valid=false, but passed"
        needle = expected.get("failing_field_contains")
        if needle and needle not in err_text:
            return False, f"error does not mention {needle!r}: {err_text[:200]}"
        return True, "ok"

    return False, f"unknown scenario: {scenario!r}"


# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------

SUITES: dict[str, Callable[[dict], tuple[bool, str]]] = {
    "core": run_core,
    "gate": run_gate,
    "allowlist": run_allowlist,
    "rate-limit": run_rate_limit,
    "contract": run_contract,
    "fidelity-guard": run_fidelity_guard,
    "id-family": run_id_family,
    "cron": run_cron,
    "delivery": run_delivery,
    "audit": run_audit,
    "render": run_render,
    "manifest": run_manifest,
}

SUITE_ORDER = ["core", "gate", "allowlist", "rate-limit", "contract", "fidelity-guard", "id-family", "cron", "delivery", "audit", "render", "manifest"]


def _fixtures_root() -> Path:
    override = os.environ.get("BOTJI_HARNESS_FIXTURES")
    if override and Path(override).is_dir():
        return Path(override)
    home_root = Path(os.environ.get("HERMES_HOME", "/opt/data")) / "tests" / "fixtures"
    if home_root.is_dir():
        return home_root
    return Path(__file__).resolve().parents[2] / "tests" / "fixtures"


def _load_fixtures(suite: str) -> list[tuple[Path, dict]]:
    root = _fixtures_root() / suite
    if not root.is_dir():
        return []
    fixtures: list[tuple[Path, dict]] = []
    for path in sorted(root.glob("*.yaml")):
        with path.open("r", encoding="utf-8") as fh:
            data = yaml.safe_load(fh)
        if not isinstance(data, dict):
            raise ValueError(f"fixture {path} is not a mapping")
        data.setdefault("id", path.stem)
        fixtures.append((path, data))
    return fixtures


def _run_suite(suite: str) -> tuple[int, int]:
    handler = SUITES[suite]
    fixtures = _load_fixtures(suite)
    if not fixtures:
        print(f"[{suite}] no fixtures found", file=sys.stderr)
        return 0, 0
    passed = 0
    for path, fixture in fixtures:
        fid = fixture.get("id") or path.stem
        try:
            ok, detail = handler(fixture)
        except Exception as exc:  # noqa: BLE001 — surface unexpected errors
            ok, detail = False, f"{type(exc).__name__}: {exc}"
        print(f"  [{suite}] {fid}: {'pass' if ok else 'FAIL'} ({detail})")
        if ok:
            passed += 1
    return passed, len(fixtures)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Unified Botji deterministic harness runner")
    sub = parser.add_subparsers(dest="cmd", required=True)
    run_cmd = sub.add_parser("run", help="Run one or all suites")
    run_cmd.add_argument("--suite", required=True, help="suite name or 'all'")
    args = parser.parse_args(argv)

    if args.suite == "all":
        suites = SUITE_ORDER
    elif args.suite in SUITES:
        suites = [args.suite]
    else:
        print(f"unknown suite: {args.suite}; expected one of: {', '.join(SUITE_ORDER + ['all'])}", file=sys.stderr)
        return 2

    total_pass = 0
    total_run = 0
    failures: list[str] = []
    for suite in suites:
        print(f"=== suite: {suite} ===")
        p, r = _run_suite(suite)
        total_pass += p
        total_run += r
        if p != r:
            failures.append(f"{suite}: {r - p}/{r} failed")

    print(json.dumps({
        "success": not failures,
        "suites": suites,
        "fixtures_passed": total_pass,
        "fixtures_total": total_run,
        "failures": failures,
    }, indent=2))
    return 0 if not failures else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"success": False, "error": str(exc), "error_type": type(exc).__name__}, indent=2), file=sys.stderr)
        raise SystemExit(2)
